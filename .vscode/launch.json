{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start mock OpenAI server",
      "request": "launch",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/mock_openai_server",
      "runtimeArgs": [
        "start"
      ],
      "runtimeExecutable": "npm",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "name": "Start mock AI server",
      "request": "launch",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/mock_anthropic_server",
      "runtimeArgs": [
        "start"
      ],
      "runtimeExecutable": "npm",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node"
    },
    {
      "type": "lldb",
      "name": "Start server",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "args": ["start", "--no-banner"],
      "cargo": { "args": ["build", "--bin", "cooking-server", "--manifest-path", "${workspaceFolder}/server/Cargo.toml"] },
      "envFile": "${workspaceFolder}/server/.env",
      "env": {
        "AZURE_KEYVAULT_ENDPOINT": "https://p06-cooking.vault.azure.net"
      }
    }
  ]
}
