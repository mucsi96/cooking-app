# Copy to .env for VS Code, or export these variables before go run ./cmd/server.
SERVER_PORT=8063
MANAGEMENT_PORT=8162
DB_URL=postgres://localhost:5460/cooking?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=postgres
STORAGE_DIRECTORY=./storage
# Real Azure AD authentication is also used locally.
TENANT_ID=replace-me
API_CLIENT_ID=replace-me
SPA_CLIENT_ID=replace-me
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
# Alternatively set AZURE_KEYVAULT_ENDPOINT and use az login / workload identity.
